{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "app",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app/src/**/*", "app/test/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}

{
  "name": "report-pilot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Report Pilot NL to SQL backend (bootstrap runtime)",
  "scripts": {
    "dev:fe": "npm --prefix frontend run dev",
    "dev:be": "tsx watch app/src/start.ts",
    "setup": "npm ci && npm --prefix frontend ci && npm --prefix tools/openapi-typescript ci",
    "build:fe": "npm --prefix frontend run build",
    "build:be": "tsc",
    "dev": "concurrently \"npm run dev:fe\" \"npm run dev:be\"",
    "build": "npm run build:fe && npm run build:be",
    "start": "node dist/src/start.js",
    "migrate": "tsx app/src/migrate.ts",
    "benchmark:mvp": "tsx app/src/benchmark/runMvpBenchmark.ts",
    "benchmark:large-schema": "tsx app/src/benchmark/runLargeSchemaBenchmark.ts",
    "create-user": "tsx scripts/create-user.ts",
    "test": "node --import tsx --test app/test/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "types:openapi": "npm --prefix tools/openapi-typescript run generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "csv-stringify": "^6.6.0",
    "mssql": "^11.0.1",
    "node-sql-parser": "^5.3.8",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "parquetjs-lite": "^0.8.7",
    "pg": "^8.13.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.3",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2"
  }
}
